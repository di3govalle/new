# =============================================================================
#  Copy this file to .env  ->  cp .env.example .env
#  Fill in your real values in .env (which is gitignored). NEVER edit secrets
#  into this template, and never commit .env.
# =============================================================================

# --- App mode -----------------------------------------------------------------
# true  = use built-in mock responses (no server needed)
# false = call the real watsonx Orchestrate /runs API (Connected Mode)
VITE_USE_MOCKS=true

# Base URL the frontend calls. Use /api so requests go through the Vite proxy
# (handles CORS + auth). Leave as /api for Connected Mode.
VITE_ORCHESTRATE_BASE_URL=/api

# --- Agent IDs (from Agent Builder in the WO console) -------------------------
# Open each agent and copy its UUID (in the details panel or the browser URL).
VITE_WEATHER_AGENT_ID=replace-with-weather-agent-id
VITE_STOCK_AGENT_ID=replace-with-stock-agent-id
VITE_KNOWLEDGE_AGENT_ID=replace-with-knowledge-agent-id

# =============================================================================
#  SERVER-SIDE ONLY (never shipped to the browser — no VITE_ prefix)
# =============================================================================

# --- watsonx Orchestrate instance + auth --------------------------------------
# WO_INSTANCE : your service instance URL (WO console -> instance details)
# WO_API_KEY  : generate in the WO console (Settings -> API details)
# WO_AUTH_TYPE: "mcsp" for AWS/SaaS, "ibm_iam" for IBM Cloud
# WO_ENV_NAME : the ADK environment name you created with `orchestrate env add`
WO_INSTANCE=replace-with-service-instance-url
WO_API_KEY=replace-with-api-key
WO_AUTH_TYPE=mcsp
WO_ENV_NAME=saas

# Optional: override the token endpoint if the default is wrong for your region.
# WO_AUTH_URL=

# Used only when starting the local Developer Edition.
WO_DEVELOPER_EDITION_SOURCE=orchestrate

# --- Stock tool (only if you read the key from env instead of a connection) ---
# Sign up free at https://finnhub.io -> Dashboard -> API key
FINNHUB_API_KEY=replace-with-finnhub-key
